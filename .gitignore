# Local caches / tooling — never commit
.npm-cache/
.pnpm-store/
.tools/
node_modules/
*.log
.DS_Store

# Deploy/debug logs — never commit
logs_*/

# Local tool/agent caches & scratch outputs — never commit
.workbuddy/
outputs/

# Secrets & local config — never commit
# 本项目 API Key 只存浏览器 localStorage，不应有任何密钥文件；以下为兜底防线
.env
.env.*
*.local
*.pem
*.key
*.p12
secrets.*
credentials*

# Editor / OS scratch files — never commit
.vscode/
.idea/
*.swp
*~
*.tmp
*.bak
*.orig
Thumbs.db
